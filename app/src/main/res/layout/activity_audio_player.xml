<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient"
    tools:context=".AudioPlayerActivity">

    <ImageView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/imagecorner"
        app:srcCompat="@drawable/placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cur_track"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginBottom="60dp" />

    <ImageView
        android:id="@+id/button_like"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:padding="5dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/like" />

    <ImageView
        android:id="@+id/button_files"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:srcCompat="@drawable/music_folder" />

    <TextView
        android:id="@+id/cur_track"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Не исполняется"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintBottom_toTopOf="@+id/author"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/button_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/volume_control"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:srcCompat="@drawable/button_music_yes" />

    <TextView
        android:id="@+id/author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Автор"
        android:textSize="16sp"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintBottom_toTopOf="@+id/time_bar"
        android:layout_marginBottom="34dp" />

    <SeekBar
        android:id="@+id/time_bar"
        style="?android:attr/seekBarStyle"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintBottom_toTopOf="@+id/control_buttons"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/cur_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/time_bar"
        app:layout_constraintTop_toBottomOf="@id/time_bar"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/time_of_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/time_bar"
        app:layout_constraintTop_toBottomOf="@id/time_bar"
        android:layout_marginTop="4dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintBottom_toTopOf="@+id/volume_control"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/button_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:rotation="180"
            app:srcCompat="@drawable/forward_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_play"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="32dp" />

        <ImageView
            android:id="@+id/button_play"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:srcCompat="@drawable/button_play"
            app:layout_constraintStart_toEndOf="@+id/button_prev"
            app:layout_constraintEnd_toStartOf="@+id/button_next"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/button_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/forward_button"
            app:layout_constraintStart_toEndOf="@+id/button_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/volume_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="92dp">

        <ImageView
            android:id="@+id/volume_no"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/volume_no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/volume_bar"
            style="?android:attr/seekBarStyle"
            android:layout_width="0dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toEndOf="@id/volume_no"
            app:layout_constraintEnd_toStartOf="@id/volume_yes"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/volume_yes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/volume_yes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>